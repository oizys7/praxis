  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.8.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
