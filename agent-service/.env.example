# ============================================
# Praxis Agent Service 环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
#
# 说明：应用内置「设置」页（保存即热加载，持久化到 settings.json），
# 是 LLM 配置的推荐入口。本文件与下方变量仅作为【冷启动初始值】：
# 设置页从未保存过时，服务才按这些变量初始化。
# ============================================

# LLM 提供商：openai | anthropic | deepseek | glm | opencode
LLM_PROVIDER=openai

# ---- 通用 OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic（Claude，官方 SDK）----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- DeepSeek（官方 SDK，api.deepseek.com）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 智谱 GLM（开放平台 open.bigmodel.cn）----
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash

# ---- OpenCode Go 套餐（OpenAI 兼容端点 opencode.ai/zen/go）----
OPENCODE_API_KEY=
OPENCODE_MODEL=grok-4.7

# ---- 服务监听（不支持设置页热更，进程生命周期属性）----
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8000

# ===== Tauri（Rust）侧 =====
# Rust 端读取进程环境变量决定 Agent 服务地址；未设置时默认 http://127.0.0.1:8000
# 仅开发模式生效；release 模式使用内置 sidecar + 随机动态端口
AGENT_SERVICE_URL=http://127.0.0.1:8000

# ===== 离线演示模式 =====
# 设为 true 时完全不调用 LLM，返回确定性 Mock 计划（无需 API Key，便于开发调试 UI）
PRAXIS_ALLOW_MOCK_LLM=false
