# ============================================
# Praxis Agent Service 环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# ============================================

# LLM 提供商：openai（默认）或 anthropic
LLM_PROVIDER=openai

# OpenAI 配置（LLM_PROVIDER=openai 时必填 API Key）
OPENAI_API_KEY=
# 可选：覆盖默认模型
OPENAI_MODEL=gpt-4o-mini

# Anthropic 配置（LLM_PROVIDER=anthropic 时必填 API Key）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 服务监听地址（Tauri 侧默认请求 http://127.0.0.1:8000）
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8000

# ===== Tauri（Rust）侧 =====
# Rust 端读取进程环境变量决定 Agent 服务地址；未设置时默认 http://127.0.0.1:8000
AGENT_SERVICE_URL=http://127.0.0.1:8000

# ===== 离线演示模式 =====
# 设为 true 时完全不调用 LLM，返回确定性 Mock 计划（无需 API Key，便于开发调试 UI）
PRAXIS_ALLOW_MOCK_LLM=false
